# Sentinel AI — SMTP Email Configuration
# Copy this file to .env and fill in your SMTP credentials to send real emails.
# If SMTP_USER or SMTP_PASSWORD is left empty, Sentinel AI runs in Development Mode,
# printing the 6-digit OTP directly to the backend terminal.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=Sentinel AI <your_email@gmail.com>
SMTP_USE_TLS=true
